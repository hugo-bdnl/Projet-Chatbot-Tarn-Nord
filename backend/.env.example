# Copier en .env (jamais commité). Toutes les variables sont optionnelles.

# Dossiers (en local ; dans Docker ils sont fixés à /corpus, /data et /app/seed)
CHATBOT_CORPUS_DIR=corpus
CHATBOT_DATA_DIR=data
CHATBOT_SEED_FILE=seed/organizations.json

# Modèle d'embedding multilingue (CPU). Alternative plus précise mais 2x plus lente : intfloat/multilingual-e5-base
CHATBOT_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Seuil de fiabilité (similarité cosinus). À recalibrer avec `python -m app.cli eval -v` après évolution de l'annuaire.
CHATBOT_MIN_SCORE=0.825
# Mode de recherche par défaut de /ask : hybrid (sémantique + BM25, barrière sémantique) | semantic | keyword
CHATBOT_DEFAULT_MODE=hybrid

# Découpage des fiches en passages
CHATBOT_CHUNK_SIZE=700
CHATBOT_CHUNK_OVERLAP=100

# API
CHATBOT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# OBLIGATOIRE hors développement : protège tous les endpoints /admin/* (header X-API-Key)
CHATBOT_API_KEY=
CHATBOT_ANALYTICS_RETENTION_DAYS=365
CHATBOT_AUTO_SEED=true
CHATBOT_AUTO_INGEST=true
CHATBOT_LOG_LEVEL=INFO

# Docker uniquement
CHATBOT_PORT=8000
